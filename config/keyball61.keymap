#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "BASE";
            bindings = <
&kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                               &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS
&kp DEL    &kp Q      &kp W      &kp E      &kp R      &kp T                                &kp Y      &kp U      &kp I      &kp O      &kp P      &kp INT3
&kp TAB    &kp A      &kp S      &kp D      &kp F      &kp G                                &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp LS(N7)
&mo 1      &kp Z      &kp X      &kp C      &kp V      &kp B      &kp RBRC       &kp NON_US_HASH &kp N      &kp M      &kp COMMA  &kp DOT    &kp SLSH   &kp RSFT
&none      &kp LCTRL  &kp LALT   &kp LGUI   &mo 6      &lt 4 SPACE &mo 5          &kp BSPC   &lt 2 ENTER &lt 1 INT1 &kp RGUI
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp LS(ESC) &kp LS(N1) &kp LBRC   &kp LS(N3) &kp LS(N4) &kp LS(N5)                          &kp EQUAL  &kp LS(N6) &kp LS(SQT) &kp LS(N8) &kp LS(N9) &kp INT1
&kp LS(DEL) &kp LS(Q)  &kp LS(W)  &kp LS(E)  &kp LS(R)  &kp LS(T)                           &kp LS(Y)  &kp LS(U)  &kp LS(I)   &kp LS(O)  &kp LS(P)  &kp INT3
&kp LS(TAB) &kp LS(A)  &kp LS(S)  &kp LS(D)  &kp LS(F)  &kp LS(G)                           &kp LS(H)  &kp LS(J)  &kp LS(K)   &kp LS(L)  &kp SQT    &kp LS(N2)
&trans      &kp LS(Z)  &kp LS(X)  &kp LS(C)  &kp LS(V)  &kp LS(B)  &trans         &trans     &kp LS(N)  &kp LS(M)  &kp LS(COMMA) &kp LS(DOT) &kp LS(SLSH) &kp LS(RSFT)
&trans      &trans     &trans     &trans     &trans     &trans     &trans         &trans     &trans     &trans     &trans
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&none      &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                               &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11
&none      &none      &kp N7     &kp N8     &kp N9     &none                                &none      &kp LEFT   &kp UP     &kp RIGHT  &none      &kp F12
&none      &none      &kp N4     &kp N5     &kp N6     &kp LS(SEMI)                         &kp PG_UP  &mkp LCLK  &kp DOWN   &mkp RCLK  &mkp MCLK  &none
&trans     &none      &kp N1     &kp N2     &kp N3     &kp LS(MINUS) &trans        &trans     &kp PG_DN  &none      &none      &none      &none      &trans
&trans     &none      &kp N0     &kp DOT    &trans     &trans     &trans         &trans     &trans     &none      &none
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans     &trans  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans     &trans  &trans &trans &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &kp PG_UP &mkp LCLK &trans &mkp RCLK &mkp MCLK &trans
&trans &trans &trans &trans &trans &trans &trans     &trans  &kp PAGE_DOWN &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans     &trans  &trans &trans &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans     &trans  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans     &trans  &trans &trans &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4              &trans &trans &trans &trans &trans &trans
&trans &trans       &trans       &trans       &trans       &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans       &trans       &trans       &trans       &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans       &trans       &trans       &trans       &trans &trans     &trans  &trans &trans &trans &trans &trans &trans
&trans &trans       &trans       &trans       &trans       &trans &trans     &trans  &trans &trans &trans
            >;
        };
    };
};
