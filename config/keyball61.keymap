#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                               &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp MINUS
&kp DEL    &kp Q      &kp W      &kp E      &kp R      &kp T                                &kp Y      &kp U      &kp I      &kp O      &kp P      &kp INT3
&kp TAB    &kp A      &kp S      &kp D      &kp F      &kp G                                &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp LS(N7)
&mo 1      &kp Z      &kp X      &kp C      &kp V      &kp B      &kp RBRC       &kp NUHS   &kp N      &kp M      &kp COMMA  &kp DOT    &kp SLSH   &kp RSFT
&none      &kp LCTRL  &kp LALT   &kp LGUI   &mo 3      &lt 2 SPACE &mo 1         &kp BSPC   &lt 2 ENTER &none     &none
            >;
        };

        layer_1 {
            bindings = <
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans     &trans  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans     &trans  &trans &trans &trans
            >;
        };

        layer_2 {
            bindings = <
&none      &kp F1     &kp F2     &kp F3     &kp F4     &kp F5                               &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11
&none      &none      &kp N7     &kp N8     &kp N9     &none                                &none      &kp LEFT   &kp UP     &kp RIGHT  &none      &kp F12
&none      &none      &kp N4     &kp N5     &kp N6     &kp LS(SEMI)                         &kp PG_UP  &mkp LCLK  &kp DOWN   &mkp RCLK  &mkp MCLK  &none
&trans     &none      &kp N1     &kp N2     &kp N3     &kp LS(MINUS) &trans        &trans     &kp PG_DN  &none      &none      &none      &none      &trans
&trans     &none      &kp N0     &kp DOT    &trans     &trans     &trans         &trans     &trans     &none      &none
            >;
        };

        layer_3 {
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                 &none      &none      &none      &none      &none      &none
&none      &none      &none      &none      &none      &none                                &none      &none      &none      &none      &none      &none
&none      &none      &none      &none      &none      &none                                &none      &none      &none      &none      &none      &bootloader
&trans     &none      &none      &none      &none      &none      &none          &none      &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none      &trans
&bootloader &none     &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &trans         &trans     &kp BSPC   &none      &none
            >;
        };
    };
};
